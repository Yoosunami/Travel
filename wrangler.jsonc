{
  "name": "travel",
  "main": "worker.js",
  "compatibility_date": "2026-06-08",
  "assets": {
    "directory": "."
  },
  "d1_databases": [
    {
      "binding": "TRAVEL_DB",
      "database_name": "travel-db",
      "database_id": "REPLACE_WITH_D1_DATABASE_ID"
    }
  ],
  "observability": {
    "enabled": true
  }
}
